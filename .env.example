# Public site URL — used for canonical, hreflang, Open Graph, the sitemap and
# the privacy policy. Required for `next build`: the build fails while this is
# missing or still the placeholder. In `next dev` it falls back to localhost.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Contact form delivery (optional). Without these, the form validates but
# honestly reports that online submissions are not connected yet.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
